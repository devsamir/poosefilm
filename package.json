{
  "name": "poosefilm",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-with-worker.mjs",
    "dev:web": "remix vite:dev",
    "build": "remix vite:build",
    "start": "remix-serve ./build/server/index.js",
    "worker": "tsx app/worker/filter-render-worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "r2:cors": "node --env-file=.env scripts/configure-r2-cors.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@prisma/client": "^5.19.1",
    "@remix-run/node": "^2.12.0",
    "@remix-run/react": "^2.12.0",
    "@remix-run/serve": "^2.12.0",
    "bcryptjs": "^2.4.3",
    "isbot": "^4.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.38.0",
    "postcss": "^8.4.38",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.13",
    "typescript": "^5.1.6",
    "vite": "^5.1.0",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
